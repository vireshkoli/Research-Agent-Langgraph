# Copy to .env and fill in. Never commit .env.

# Required: powers the agent loop, the reflection step, and the eval judge.
OPENAI_API_KEY=sk-...

# Required for the web_search tool. Free tier is 1000 credits/month, no credit card.
# https://app.tavily.com
TAVILY_API_KEY=tvly-...

# Optional: a second judge from a different model family. The agent and the
# default judge are both OpenAI models — different generations, not different
# families — so judge self-preference is currently disclaimed rather than
# measured. Supplying this lets evals/ re-judge the committed trajectories with
# a cross-family judge and report inter-judge agreement beside the existing
# judge-vs-human kappa. Nothing in src/ reads it; the agent is unaffected.
# https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown)

# --- Models ---
# RA_AGENT_MODEL=gpt-5.4-nano
# RA_JUDGE_MODEL=gpt-5.6-luna
# RA_JUDGE_REFERENCE_MODEL=gpt-5.6-terra
# Reasoning tokens bill as output at the full rate, so the loop defaults to none.
# RA_REASONING_EFFORT=none
# RA_PLAN_REASONING_EFFORT=low

# --- Per-run budgets: the agent cannot exceed these, ever ---
# RA_MAX_STEPS=8
# RA_MAX_SECONDS=120
# RA_MAX_RUN_COST_USD=0.05
# Withheld from the loop so finalize can always afford to answer.
# RA_FINALIZE_RESERVE_USD=0.008

# --- Spend guards, outermost first. 0 disables any of them. ---
# Hard ceiling on everything this project ever spends, persisted in .spend.json
# across restarts. This is the one that actually bounds the project.
# RA_MAX_PROJECT_COST_USD=5.00
# Per-process kill switch; fires even if a caller forgets to pass a CostTracker.
# RA_MAX_PROCESS_COST_USD=0.50

# --- Development cache: replay recorded LLM responses instead of paying again ---
# off (default) | auto (replay if recorded, else call and record) | record | replay
# MUST stay off for the official eval — replayed runs are not independent and
# pass^k over non-independent runs is meaningless.
# RA_LLM_CACHE=auto

# --- Public demo spend caps (only read by app.py) ---
# RA_DAILY_CAP_USD=0.25
# RA_MAX_QUESTION_CHARS=500
