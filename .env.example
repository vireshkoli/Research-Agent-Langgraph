# Copy to .env and fill in. Never commit .env.

# Required: powers the agent loop, the reflection step, and the eval judge.
OPENAI_API_KEY=sk-...

# Required for the web_search tool. Free tier is 1000 credits/month, no credit card.
# https://app.tavily.com
TAVILY_API_KEY=tvly-...

# Optional overrides (defaults shown)

# --- Models ---
# RA_AGENT_MODEL=gpt-5.4-nano
# RA_JUDGE_MODEL=gpt-5.6-terra
# RA_REASONING_EFFORT=low

# --- Per-run budgets: the agent cannot exceed these, ever ---
# RA_MAX_STEPS=8
# RA_MAX_SECONDS=120
# RA_MAX_RUN_COST_USD=0.05
# RA_FINALIZE_RESERVE_USD=0.008

# --- Process-level kill switch. Guards against a runaway dev loop even when a
# --- caller forgets to pass a CostTracker. Set to 0 to disable (not advised).
# RA_MAX_PROCESS_COST_USD=2.00

# --- Public demo spend caps (only read by app.py) ---
# RA_DAILY_CAP_USD=0.25
# RA_MAX_QUESTION_CHARS=500
